---
// LocalTip.astro - Small staff-recommendation callout for conference/travel
// posts, meant to break up a long linear section (like a paper list) without
// sitting inside/overlapping the wide FeatureRow bands next to it.
//
// Three width regimes, matching FeatureRow's own breakpoints exactly:
//   < 1200px:        plain column width (same as FeatureRow below its own breakout)
//   1200px – 1759px: mirrors FeatureRow's own breakout formula, so an inline
//                     tip is always exactly as wide as the FeatureRow next to it
//   >= 1760px:        enough true page margin exists beside FeatureRow's
//                     72rem-capped band to pop the note out into the margin
//                     instead of stacking inline; see the float rules below.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;   // e.g. "Where to get coffee"
  name: string;    // recommender's name, e.g. "Alyssa Emigh Hudak"
  role?: string;   // e.g. "Adjunct Lecturer, Makerspace Supervisor"
  photo: ImageMetadata;
  flip?: boolean;  // margin note on the left instead of the right (wide viewports only)
}

const { title, name, role, photo, flip = false } = Astro.props;
---

<aside
  class:list={[
    // Bottom-only margin, no top: matches FeatureRow's own mb-12 with no
    // top margin, so the gap above and below a tip is exactly the same as
    // the gap between two FeatureRows, rather than depending on whether
    // adjoining margins happen to collapse.
    'not-prose mb-12 rounded-lg border border-maize/60 p-4',
    'dark:border-maize/40',
    // Inline-wide mode: identical breakout formula to FeatureRow.astro,
    // scoped to exactly the range where FeatureRow itself is breaking out
    // but the margin-note mode below hasn't kicked in yet, so the two never
    // fight over the same properties.
    'min-[1200px]:max-[1759px]:relative min-[1200px]:max-[1759px]:left-1/2',
    'min-[1200px]:max-[1759px]:-translate-x-1/2',
    'min-[1200px]:max-[1759px]:w-[min(72rem,calc(100vw-5rem))]',
    // Margin-note mode: float (not relative+transform) so the note doesn't
    // reserve block-flow height — a relatively-positioned box still pushes
    // the next sibling down by its own height even though it's rendered off
    // to the side, which is exactly the gap we don't want between two
    // FeatureRows. A float is removed from block flow, so the next
    // FeatureRow starts immediately after the previous one instead.
    //
    // The note's home column is 56rem (max-w-4xl) but has 2rem of padding
    // (lg:px-8 on the wrapper in News.astro) on each side, so a plain float
    // flushes at 26rem from center, not 28rem. FeatureRow breaks out to
    // 72rem, i.e. 36rem from center. Distance from the float's flush point
    // to FeatureRow's edge is therefore 36-26=10rem; add a 2rem visual gap
    // and the note's own 16rem width pulled out via negative margin:
    // 10+2+16=28rem. Flip mirrors the same math to the left edge instead.
    //
    // -mt-16 pulls the note up so it straddles the gap between the previous
    // and next FeatureRow, rather than starting flush with the next one's
    // top edge (its own top margin was removed above; without this pull it
    // would otherwise begin at exactly the same height the next row does).
    flip
      ? 'min-[1760px]:float-left min-[1760px]:-mt-16 min-[1760px]:w-64 min-[1760px]:-ml-112'
      : 'min-[1760px]:float-right min-[1760px]:-mt-16 min-[1760px]:w-64 min-[1760px]:-mr-112',
  ]}
>
  <h3 class="mb-1 text-md font-bold uppercase">Pittsburgh tip</h3>
  <p class="mb-2 text-sm font-bold text-umichblue dark:text-neutral-100">{title}</p>
  <div class="text-sm leading-relaxed text-gray-700 dark:text-gray-300">
    <slot />
  </div>
  <div class="mt-3 flex items-center gap-2">
    <Image src={photo} alt={name} width={72} class="h-8 w-8 rounded-full object-cover" />
    <div class="leading-tight">
      <p class="text-xs font-semibold text-gray-700 dark:text-gray-300">{name}</p>
      {role && <p class="text-[0.7rem] text-gray-700 dark:text-gray-300">{role}</p>}
    </div>
  </div>
</aside>
