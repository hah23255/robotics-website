---
// TimelineItem.astro - A card on the Timeline: title, body slot. `areas` still
// tags the card with data-areas for FocusFilter to match against; it just isn't
// rendered as visible chips.
interface Props {
  title: string;
  areas?: string[]; // focus-area slugs
}
const { title, areas = [] } = Astro.props;
---

<div
  class="mb-3 rounded bg-white px-5 pt-4 pb-4 shadow-[0_1px_3px_rgba(0,39,76,0.08),0_6px_18px_rgba(0,39,76,0.07)] dark:bg-[color-mix(in_srgb,var(--color-arboretumBlue)_25%,#111827)] dark:shadow-[0_1px_3px_rgba(0,0,0,0.4),0_6px_18px_rgba(0,0,0,0.35)]"
  data-areas={areas.length > 0 ? areas.join(' ') : undefined}
>
  <h3 class="text-balance mb-1.5 text-lg leading-tight font-bold text-umichblue dark:text-neutral-100">
    {title}
  </h3>
  <div class="text-sm leading-relaxed [&_p]:mb-2 [&_p:last-child]:mb-0">
    <slot />
  </div>
</div>
